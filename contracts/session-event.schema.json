      "oneOf": [
        {
          "const": "completed",
          "description": "normal end: the model answered without further tool calls"
        },
        {
          "const": "cancelled",
          "description": "cooperative cancel fired; partial output/tool results stay in the log"
        },
        {
          "type": "object",
          "required": [
            "error"
