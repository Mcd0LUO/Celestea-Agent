            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        {
          "title": "thinking_delta",
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "thinking_delta"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        {
          "title": "tool_call",
          "type": "object",
          "required": [
            "type",
            "id",
            "name",
            "args"
          ],
          "properties": {
            "type": {
              "const": "tool_call"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "args": {},
            "parent_id": {
              "type": "string",
              "description": "W255 run_code sub-call: Some(<parent call id>); the row is logged for audit/replay but derive_messages skips it"
            }
          },
          "additionalProperties": true
        },
        {
          "title": "tool_result",
          "type": "object",
          "required": [
            "type",
            "id",
            "value",
            "error"
          ],
          "properties": {
            "type": {
              "const": "tool_result"
            },
            "id": {
              "type": "string"
            },
            "value": {},
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "parent_id": {
              "type": "string",
              "description": "same contract as tool_call.parent_id"
            }
          },
          "additionalProperties": true
        },
        {
          "title": "user_question",
          "type": "object",
          "required": [
            "type",
            "id",
            "questions"
          ],
          "properties": {
            "type": {
              "const": "user_question"
            },
            "id": {
