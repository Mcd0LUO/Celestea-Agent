# W847 W0 dependency policy — see docs/DEPENDENCY-POLICY.md.
#
# MEASURED pnpm 11.22.0 behavior: when pnpm-workspace.yaml exists, pnpm reads the
# PROJECT settings from pnpm-workspace.yaml and IGNORES this .npmrc (with these
# keys here, pnpm config get --location project engineStrict stayed undefined and
# a manifest-only change still rewrote pnpm-lock.yaml). The enforceable pair lives
# in pnpm-workspace.yaml (engineStrict: true, frozenLockfile: true). These keys
# are kept so npm-compatible tooling sees the same intent.
engine-strict=true
frozen-lockfile=true
