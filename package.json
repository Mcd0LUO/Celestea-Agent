{
  "name": "celestea-studio-ts",
  "version": "0.1.0-p0",
  "private": true,
  "type": "module",
  "description": "Celestea Studio backend - TypeScript rewrite (P0: contract freeze + skeleton + golden-sample toolchain)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx scripts/bench/index.ts",
    "contracts:verify": "tsx scripts/verify-contracts.ts",
    "golden:export": "tsx scripts/export-golden.ts",
    "replay:compare": "tsx scripts/compare-replay.ts",
    "replay:e2e": "tsx scripts/replay-e2e.ts",
    "lint": "eslint .",
    "lint:arch": "depcruise --config .dependency-cruiser.cjs packages apps scripts tests",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:arch && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  }
}
