{
  "name": "celestea-agent",
  "version": "2.7.5",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Celestea Studio agent — web UI + HTTP API, one command",
  "bin": {
    "celestea": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/make-bin-executable.mjs dist/main.js"
  },
  "dependencies": {
    "@celestea/core": "workspace:*",
    "@celestea/studio": "workspace:*",
    "@celestea/tools": "workspace:*"
  }
}
