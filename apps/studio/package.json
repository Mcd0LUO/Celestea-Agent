{
  "name": "@celestea/studio",
  "version": "2.7.4",
  "private": false,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-webdist.mjs"
  },
  "dependencies": {
    "@celestea/agent-loop": "workspace:*",
    "@celestea/core": "workspace:*",
    "@celestea/llm": "workspace:*",
    "@celestea/runtime": "workspace:*",
    "@celestea/session": "workspace:*",
    "@celestea/tools": "workspace:*",
    "@celestea/workers": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8"
  },
  "files": [
    "dist",
    "webdist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
