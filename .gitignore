node_modules/
dist/
*.log
.env
.DS_Store
# generated probe evidence is committed on purpose; keep scratch output out
reports/*.tmp

# generated per-run compare output
reports/replay-diff-*.json
results/

# 真实会话导出的 golden fixture 绝不入库（含私人对话）；合成 fixture 用 ! 例外保留
fixtures/sessions/*
!fixtures/sessions/test-*/
!fixtures/sessions/scratch-*/

# Celestea 会话产物（对话日志/附件/授权/检查点）。
# 工作区根可能就是一个 git 仓库（本项目自己就是），会话数据绝不能进版本库。
# W880：canonical 产物已全部移出工作区，落到 $CELESTEA_HOME
#   （<home>/workspaces/<ws>/{sessions,archive,trash,run-code}/prompts.json）。
# 下面三条只覆盖「尚未迁移的旧数据」——迁移切片完成后即可整段删除：
#   .celestea/          W877 过渡容器 / W876 拟议容器（会话、归档、回收站、prompts、run-code）
#   .celestea-*         更老的根上产物（.celestea-trash/.celestea-archived/.celestea-prompts.json）
#   /*-[0-9]*.[0-9]*/   最老的根上会话目录（<标题>-<秒>.<纳秒>）
.celestea/
.celestea-*
/*-[0-9]*.[0-9]*/

# worker 工作树（W886）：派工时在仓内 <repo>/.worktrees/<wid> 建独立 worktree，
# 而不是 /tmp（这台机的 /tmp 是 tmpfs，node_modules 会常驻内存）。
# 它们必须是 git 与 eslint 的盲区，否则主工作树会把它们当未跟踪文件、并 lint 半成品代码。
.worktrees/
